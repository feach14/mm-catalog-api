<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.json" CopyToPublishDirectory="Always" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Vek.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\Core.csproj"/>
    <ProjectReference Include="..\Catalog.Database\Catalog.Database.csproj" />
  </ItemGroup>

  <!-- dotnet publish не вызывает FileSystemPublish, где SDK обычно очищает папку результата. -->
  <Target Name="CleanPublishDestination"
          BeforeTargets="PrepareForPublish"
          DependsOnTargets="_DeleteDestinationFilesIfSpecified"
          Condition="'$(DeleteExistingFiles)' == 'true'" />

</Project>